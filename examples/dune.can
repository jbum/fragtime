<seq oversample=true duration=2 framerate=24 fw=512 fh=227 >
  <seq id=a min=-1 width=6 mono="noise(x,y,t*4)+fnoise(x,y,t*4)*.2" />
  <seq id=dk min=-1 width=6 mono="noise(x-.2,y-.2,t*4)" />
  <seq id=bump mono="$a*(min(0,($dk-$a))+1)" />
  <seq hsv="0.2,1-$bump,$bump" />
 
