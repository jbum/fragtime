// Mona Lisa Zoom (original image is 605/790)
<seq fw=306 fh=400 debut=0 duration=8 framerate=24
 seamless=true oversample=true
 moviefile="mona.mov"
>

	<seq id=a tile=true width=1 height=1 // endwidth="iw" 
     image="mona_lisa.bmp"
      pix="samptile(x,y)" />
		<seq id=b width=1 height=1 image="parrot.bmp"
      pix="samptile(x,y)" />
 <seq id=c tile=true pix="terp($a,$b)" />

</seq>
