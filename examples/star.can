<seq duration=4 oversample=false fw=400 fh=400 framerate=24 >
  <seq id=b min=0 max=1 width=8 mono="abs(cos(2^int(d+1)*a-t*pi2))" />
  <seq id=c min=0 max=1 width=8 mono="abs(cos(2^int(d+2)*a-t*pi2))" />
  <seq id=mask width=8 mono="(d+1)-int(d+1)" />
  <seq id=na center=true left=12 width=6 endwidth=3 mono="turb(x,y,t*4,.5,2.05,8)" />
  <seq id=nb center=true left=12 width=12 endwidth=6 mono="turb(x,y,t*4-4,.5,2.05,8)" />
  <seq id=n mono="terp($na,$nb)" />
  <seq id=stara min=-.4 max=1.55 mono="terp($b,$c,$mask)+($n-.5)" />
  <seq id=star mono="$stara{d,a+log(d)*sin(t*pi2)*.1}" />
  <seq id=starmask mono="1-min(1,ease(max(0,(d+($n-.5)*.3)*1.3),.99))" />
  <seq id=starmask min=-1 mono="max(1-sin(a*32),1-min(1,ease(d*1.3,.99)))" />
  <seq id=nstar pix="terp(0,bias($star,.7),$starmask)" />
  <seq id=cstar hsv="ease(d*2,.5+sin(t*pi2)*.25),ease(1-(d+$nstar-.5)*1.5,.75),$nstar" />
 </seq>
