<seq fw=240 fh=320 oversample=false>
  <seq duration=2>							 
    <seq id=mona image="mona_lisa.bmp" tile=true width=1 height=1 pix="samp(x,y)" />
    <seq id=a width=1 height=1 pix="$mona[x*(1+t),y*(1+t)]" />
    <seq id=b width=1 height=1 pix="$mona[2-((1-x)*(1+t)),y*(1+t)]" />
    <seq id=c width=1 height=1 pix="$mona[x*(1+t),2-((1-y)*(1+t))]" />
    <seq id=d width=1 height=1 pix="$mona[2-((1-x)*(1+t)),2-((1-y)*(1+t))]" />
    <seq id=g width=1 height=1 pix="terpt(terpt($a,$b,.5),terpt($c,$d,.5),.5)" />
			</seq>
 <seq width=2 height=2 debut=2 duration=".5" pix="$mona[x,y]" />
</seq>
